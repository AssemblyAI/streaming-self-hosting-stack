# Required for the sync stack (docker-compose.universal-3-5-pro.yml):
SYNC_API_IMAGE=344839248844.dkr.ecr.us-west-2.amazonaws.com/self-hosted-sync-asr-u3-pro:release-v1.0.0
LICENSE_AND_USAGE_PROXY_IMAGE=344839248844.dkr.ecr.us-west-2.amazonaws.com/self-hosted-streaming-license-and-usage-proxy:release-v1.0.0
USAGE_TRACKING_API_KEY=<your_usage_tracking_api_key_here>

# Audio limits. Defaults accept up to 1 h of 48 kHz stereo WAV; edit to fit
# your longest files (see "Audio limits" in README.md).
MAX_AUDIO_DURATION_MS=3600000
MIN_AUDIO_DURATION_MS=80
MAX_REQUEST_BYTES=1073741824
INFERENCE_TIMEOUT_SECONDS=300
