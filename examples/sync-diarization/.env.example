# Required for the sync + diarization stack (docker-compose.sync-diarization.yml):
SYNC_API_IMAGE=344839248844.dkr.ecr.us-west-2.amazonaws.com/self-hosted-sync-asr-universal-3-6-pro:release-v1.2.0
DIARIZATION_API_IMAGE=344839248844.dkr.ecr.us-west-2.amazonaws.com/self-hosted-diarization:release-v0.2.0
LICENSE_AND_USAGE_PROXY_IMAGE=344839248844.dkr.ecr.us-west-2.amazonaws.com/self-hosted-streaming-license-and-usage-proxy:release-v1.3.0
USAGE_TRACKING_API_KEY=<your_usage_tracking_api_key_here>

# Optional GPU selection (both default to GPU 0):
# SYNC_GPU=0
# DIARIZATION_GPU=1

# Optional sync limits (defaults shown; see ../../sync/docker/README.md):
# SYNC_MAX_AUDIO_DURATION_MS=1200000
# SYNC_MIN_AUDIO_DURATION_MS=80
# SYNC_MAX_REQUEST_BYTES=268435456
# SYNC_INFERENCE_TIMEOUT_SECONDS=30

# Optional diarization limits (defaults shown; see ../../diarization/docker/README.md):
# MAX_AUDIO_DURATION_MS=3600000
# MAX_REQUEST_BYTES=1073741824
# INFERENCE_TIMEOUT_SECONDS=300
# MAX_CONCURRENT_REQUESTS=1
