# Required for the diarization stack (docker-compose.diarization.yml):
DIARIZATION_API_IMAGE=344839248844.dkr.ecr.us-west-2.amazonaws.com/self-hosted-diarization:release-v0.2.0
LICENSE_AND_USAGE_PROXY_IMAGE=344839248844.dkr.ecr.us-west-2.amazonaws.com/self-hosted-streaming-license-and-usage-proxy:release-v1.3.0
USAGE_TRACKING_API_KEY=<your_usage_tracking_api_key_here>

# Optional limits (defaults shown; see "Limits" in README.md):
# MAX_AUDIO_DURATION_MS=3600000
# MAX_REQUEST_BYTES=1073741824
# INFERENCE_TIMEOUT_SECONDS=300
# MAX_CONCURRENT_REQUESTS=1
